{% set items = content['#items'] %}
 {% if items %}
  {% set rendered_items %}
    {% for item in items%}
      {{
      include('@atoms/menu-item-secondary.html.twig',{
        'title': item.title,
        'url': item.url,
      })
      }}
    {% endfor %}
  {% endset %}

  {{ include('@molecules/menu.html.twig',{
    'items': rendered_items,
  })
  }}
{% endif %}

